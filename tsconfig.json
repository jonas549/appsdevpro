{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "strictNullChecks": true
  },
  "//": "include cubre solo lo que Next compila. TypeScript sigue los imports hacia src/ automáticamente, así que los componentes legacy que sí usa la app (Hero, FAQ, RichTextEditor, ContentContext...) se verifican igual, y el código muerto de Vite (App.tsx, main.tsx, views/, MetaPixel.tsx) queda fuera.",
  "include": [
    "next-env.d.ts",
    "types/**/*.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "lib/**/*.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "dist",
    "_api_legacy",
    "server",
    "scripts"
  ]
}
